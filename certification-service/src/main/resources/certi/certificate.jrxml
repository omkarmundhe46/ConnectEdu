<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="certificate"
              language="java"
              pageWidth="870"
              pageHeight="600"
              orientation="Landscape"
              columnWidth="830"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">

    <parameter name="userName" class="java.lang.String"/>
    <parameter name="eventName" class="java.lang.String"/>
    <parameter name="eventDate" class="java.lang.String"/>
    <parameter name="backgroundImage" class="java.io.InputStream"/>
    <parameter name="logoImage" class="java.io.InputStream"/>
    <parameter name="aImage" class="java.io.InputStream"/>
    <!-- Separate parameters for each signature -->
    <parameter name="signatureImage1" class="java.io.InputStream"/>
    <parameter name="signatureImage2" class="java.io.InputStream"/>
    <parameter name="signatureImage3" class="java.io.InputStream"/>
    <parameter name="signatureImage4" class="java.io.InputStream"/>

    <queryString><![CDATA[]]></queryString>

    <background>
        <band splitType="Stretch"/>
    </background>

    <detail>
        <band height="500" splitType="Stretch">

            <!-- Background Image -->
            <image>
                <reportElement x="0" y="0" width="830" height="487"/>
                <imageExpression><![CDATA[$P{backgroundImage}]]></imageExpression>
            </image>

            <!-- Trust Name -->
            <staticText>
                <reportElement x="260" y="11" width="280" height="26" forecolor="#FCF7F7"/>
                <textElement textAlignment="Center">
                    <font fontName="Algerian" size="15"/>
                </textElement>
                <text><![CDATA[DR. J. J. MAGDUM TRUST'S]]></text>
            </staticText>

            <!-- College Logo -->
            <image>
                <reportElement x="10" y="11" width="109" height="100"/>
                <imageExpression><![CDATA[$P{logoImage}]]></imageExpression>
            </image>

            <!-- College Name -->
            <staticText>
                <reportElement x="119" y="26" width="690" height="90" forecolor="#FCFCFC"/>
                <textElement textAlignment="Center">
                    <font fontName="Algerian" size="25"/>
                </textElement>
                <text><![CDATA[DR. J. J. MAGDUM COLLEGE OF ENGINEERING.]]></text>
            </staticText>

            <!-- College Details -->
            <staticText>
                <reportElement x="119" y="61" width="641" height="20" forecolor="#FCF7F7"/>
                <textElement textAlignment="Center">
                    <font size="14"/>
                </textElement>
                <text><![CDATA[Approved by AICTE, New Delhi | Affiliated to Shivaji University, Kolhapur]]></text>
            </staticText>

            <staticText>
                <reportElement x="119" y="81" width="620" height="20" forecolor="#FFFAFA"/>
                <textElement textAlignment="Center">
                    <font size="14"/>
                </textElement>
                <text><![CDATA[NAAC "A" Grade Accredited Institute | ISO 21001:2018 Certified]]></text>
            </staticText>

            <!-- Department -->
            <staticText>
                <reportElement x="200" y="101" width="419" height="30" forecolor="#FAF5F5"/>
                <textElement textAlignment="Center">
                    <font fontName="Arial" size="18"/>
                </textElement>
                <text><![CDATA[Department Of INFORMATION TECHNOLOGY]]></text>
            </staticText>

            <!-- A Image -->
            <image>
                <reportElement x="350" y="141" width="110" height="120"/>
                <imageExpression><![CDATA[$P{aImage}]]></imageExpression>
            </image>

            <!-- Certificate Title -->
            <staticText>
                <reportElement x="270" y="251" width="280" height="30"/>
                <textElement textAlignment="Center">
                    <font fontName="Arial" size="15"/>
                </textElement>
                <text><![CDATA[P R O U D L Y   P R E S E N T E D   T O]]></text>
            </staticText>

            <!-- User Information -->
            <staticText>
                <reportElement x="40" y="281" width="300" height="30"/>
                <textElement>
                    <font fontName="Times New Roman" size="22"/>
                </textElement>
                <text><![CDATA[This is to certify that, Mr. / Miss.]]></text>
            </staticText>

            <textField>
                <reportElement x="350" y="281" width="290" height="30"/>
                <textElement>
                    <font fontName="Arial Rounded MT Bold" size="22"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{userName}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="640" y="281" width="170" height="30"/>
                <textElement>
                    <font fontName="Times New Roman" size="22"/>
                </textElement>
                <text><![CDATA[of IT Department]]></text>
            </staticText>

            <!-- Event Information -->
            <staticText>
                <reportElement x="70" y="311" width="210" height="30"/>
                <textElement>
                    <font fontName="Times New Roman" size="22"/>
                </textElement>
                <text><![CDATA[has participated in the]]></text>
            </staticText>

            <textField>
                <reportElement x="280" y="311" width="400" height="30"/>
                <textElement>
                    <font fontName="Arial Rounded MT Bold" size="22"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{eventName}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="680" y="311" width="90" height="30"/>
                <textElement>
                    <font fontName="Times New Roman" size="22"/>
                </textElement>
                <text><![CDATA[held at]]></text>
            </staticText>

            <staticText>
                <reportElement x="40" y="341" width="520" height="30"/>
                <textElement>
                    <font fontName="Times New Roman" size="22"/>
                </textElement>
                <text><![CDATA[DR. J. J. MAGDUM COLLEGE OF ENGINEERING on]]></text>
            </staticText>

            <textField>
                <reportElement x="560" y="341" width="250" height="30"/>
                <textElement>
                    <font fontName="Arial Rounded MT Bold" size="22"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{eventDate}]]></textFieldExpression>
            </textField>

            <!-- Signature Section - Each with separate parameter -->

            <!-- Signature 1 -->
            <image>
                <reportElement x="30" y="395" width="160" height="70"/>
                <imageExpression><![CDATA[$P{signatureImage1}]]></imageExpression>
            </image>

            <staticText>
                <reportElement x="30" y="444" width="150" height="30"/>
                <textElement>
                    <font fontName="Lucida Sans" size="18"/>
                </textElement>
                <text><![CDATA[Prof. P. R. Patil]]></text>
            </staticText>

            <staticText>
                <reportElement x="30" y="467" width="150" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="Times New Roman" size="15"/>
                </textElement>
                <text><![CDATA[Club Coordinator]]></text>
            </staticText>

            <!-- Signature 2 -->
            <image>
                <reportElement x="200" y="395" width="160" height="70"/>
                <imageExpression><![CDATA[$P{signatureImage2}]]></imageExpression>
            </image>

            <staticText>
                <reportElement x="200" y="450" width="180" height="30"/>
                <textElement>
                    <font fontName="Lucida Sans" size="18"/>
                </textElement>
                <text><![CDATA[Prof. R. A. Bhartiya]]></text>
            </staticText>

            <staticText>
                <reportElement x="200" y="470" width="150" height="19"/>
                <textElement textAlignment="Center">
                    <font fontName="Times New Roman" size="15"/>
                </textElement>
                <text><![CDATA[HOD IT]]></text>
            </staticText>

            <!-- Signature 3 -->
            <image>
                <reportElement x="400" y="395" width="160" height="70"/>
                <imageExpression><![CDATA[$P{signatureImage3}]]></imageExpression>
            </image>

            <staticText>
                <reportElement x="400" y="450" width="160" height="30"/>
                <textElement>
                    <font fontName="Lucida Sans" size="18"/>
                </textElement>
                <text><![CDATA[Prof. P. R. Patil]]></text>
            </staticText>

            <staticText>
                <reportElement x="400" y="467" width="150" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="Times New Roman" size="15"/>
                </textElement>
                <text><![CDATA[Committee Head]]></text>
            </staticText>

            <!-- Signature 4 -->
            <image>
                <reportElement x="600" y="397" width="160" height="68"/>
                <imageExpression><![CDATA[$P{signatureImage4}]]></imageExpression>
            </image>

            <staticText>
                <reportElement x="600" y="450" width="160" height="30"/>
                <textElement>
                    <font fontName="Lucida Sans" size="18"/>
                </textElement>
                <text><![CDATA[Dr. G. V. Mulgund]]></text>
            </staticText>

            <staticText>
                <reportElement x="600" y="470" width="150" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="Times New Roman" size="15"/>
                </textElement>
                <text><![CDATA[Principal]]></text>
            </staticText>

        </band>
    </detail>
</jasperReport>