		{
			"name": "Notification Service Verification",
			"item": [
				{
					"name": "Check Email Templates",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Templates exist\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an('array');",
									"    pm.expect(jsonData.length).to.be.at.least(3);",
									"    ",
									"    var templateCodes = jsonData.map(t => t.code);",
									"    pm.expect(templateCodes).to.include('WELCOME_USER');",
									"    pm.expect(templateCodes).to.include('WELCOME_CLUB_MEMBER');",
									"    pm.expect(templateCodes).to.include('EVENT_REGISTRATION_CONFIRM');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}:8085/api/notify/templates",
