		{
			"name": "User Service with Notifications",
			"item": [
				{
					"name": "Create User (Triggers Welcome Email)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response has user data\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('id');",
									"    pm.expect(jsonData).to.have.property('name');",
									"    pm.expect(jsonData).to.have.property('email');",
									"    pm.environment.set('userId', jsonData.id);",
									"    pm.environment.set('userEmail', jsonData.email);",
									"});",
									"",
									"console.log('User created - Welcome email should be sent automatically');"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Alice Johnson\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"pass123\",\n  \"department\": \"Computer Science\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}:8081/api/users",
							"host": [
								"{{baseUrl}}"
							],
							"port": "8081",
							"path": [
								"api",
								"users"
							]
						}
					}
				}
			]
		},
